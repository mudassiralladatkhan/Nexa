{
  "name": "nexa-mobile",
  "version": "1.0.0",
  "description": "Nexa Voice Assistant - Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace NexaMobile.xcworkspace -scheme NexaMobile -configuration Release -destination generic/platform=iOS -archivePath NexaMobile.xcarchive archive",
    "clean": "react-native clean-project-auto",
    "metro": "metro start",
    "postinstall": "npx pod-install ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.5",
    "@react-native-community/netinfo": "^11.2.1",
    "@react-native-voice/voice": "^3.2.4",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-background-service": "^1.0.3",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^4.1.0",
    "react-native-reanimated": "^3.6.2",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-sound": "^0.11.2",
    "react-native-svg": "^14.1.0",
    "react-native-tts": "^4.1.0",
    "react-native-vector-icons": "^10.0.3",
    "react-navigation": "^4.4.4",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/runtime": "^7.23.7",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.2",
    "@types/react": "^18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "voice-assistant",
    "ai",
    "mobile",
    "nexa"
  ],
  "author": "Nexa Team",
  "license": "MIT"
}
